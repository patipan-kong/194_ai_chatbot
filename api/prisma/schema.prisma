// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1. ตาราง Knowledge Base (FAQ)
model KnowledgeBase {
  id        Int      @id @default(autoincrement())
  category  String   // เช่น "登録・退会について"
  question  String   @db.Text
  answer    String   @db.Text
  status    KBStatus @default(PUBLISHED)
  isActive  Boolean  @default(true)
  isDelete  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@unique([category, question])
}

// 2. ตารางเก็บ Feedback จาก User (Thumb Up/Down)
model Interaction {
  id            Int            @id @default(autoincrement())
  userId        String         @default("anonymous") // UUID from client (persistent per browser)
  settingId     Int            @default(1)
  userQuestion  String         @db.Text
  aiResponse    String         @db.Text
  modelId       String         // เช่น "gemini-2.5-flash" เพื่อเก็บสถิติว่าตัวไหนตอบดี
  isThumbUp     Boolean?       // true = up, false = down, null = no feedback yet
  inputTokens   Int?           // tokens used in prompt
  outputTokens  Int?           // tokens used in completion
  cost          Float          @default(0)
  responseTime  Int?           // ms from request to response
  createdAt     DateTime       @default(now())
  setting       SystemSetting  @relation(fields: [settingId], references: [id])
  pendingReview PendingReview?
}

// 3. ตารางสำหรับ Admin (คำถามที่ AI ตอบไม่ได้ หรือโดน Thumb Down)
model PendingReview {
  id              Int           @id @default(autoincrement())
  question        String        @db.Text
  aiResponse      String?       @db.Text
  source          ReviewSource  // ที่มาของข้อมูล (UNKNOWN_ANSWER หรือ THUMB_DOWN)
  status          ReviewStatus  @default(PENDING) // สถานะการจัดการโดย Admin
  reviewNote      String?       @db.Text
  resolvedBy      String?
  resolvedAt      DateTime?
  interactionId   Int?          @unique // เชื่อมไปยัง Interaction ที่เกิดปัญหา
  interaction     Interaction?  @relation(fields: [interactionId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// 4. ตารางสำหรับ Login 
model AdminUser {
  id           Int           @id @default(autoincrement())
  username     String        @db.Text
  password     String       @db.Text
  isDelete     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model SystemSetting {
  id                     Int      @id @default(autoincrement())
  version                Int      @default(1)
  description            String?  @db.Text
  systemPromptTemplate   String   @db.Text
  unknownAnswerCleanText String   @db.Text
  isActive               Boolean  @default(false)
  createdBy              String
  createdAt              DateTime @default(now())
  interactions           Interaction[]
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   Int
  oldValue   Json?
  newValue   Json?
  changedBy  String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model PromptPlaygroundRun {
  id            Int      @id @default(autoincrement())
  question      String   @db.Text
  promptTemplate String  @db.Text
  selectedModels Json?
  result        Json
  createdBy     String
  createdAt     DateTime @default(now())
}

enum ReviewSource {
  UNKNOWN_ANSWER // กรณี AI ตอบประโยค "申し訳ございませんが..."
  THUMB_DOWN     // กรณี User กด Thumb Down
}

enum ReviewStatus {
  PENDING   // รอตรวจสอบ
  RESOLVED  // เพิ่มเข้า Knowledge Base แล้ว
  IGNORED   // ข้ามไป/ไม่สำคัญ
}

enum KBStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}
