# URL of Fastify API service
API_BASE_URL=http://localhost:3001

# Simple admin UI login for Next.js middleware/login page
ADMIN_UI_USER=admin
ADMIN_UI_PASSWORD=admin123

# Must match api/.env ADMIN_API_KEY when API protection is enabled
ADMIN_API_KEY=your_admin_api_key_here

# Base URL for logout redirect
NEXT_PUBLIC_APP_URL=http://localhost:3100
