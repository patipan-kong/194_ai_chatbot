# URL of Fastify API service
API_BASE_URL=http://localhost:3001

# Must match api/.env ADMIN_API_KEY when API protection is enabled
ADMIN_API_KEY=your_admin_api_key_here

# HMAC secret for signed admin session cookies.
# REQUIRED. Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_chars

# Base URL for logout redirect
NEXT_PUBLIC_APP_URL=http://localhost:3100
